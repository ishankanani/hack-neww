# Backend API base. Default uses the Vite dev proxy (/api -> http://127.0.0.1:8004).
VITE_API_BASE=/api
# Main Google basemap. A no-billing Maps Demo Key can be used for this prototype.
# Restrict the browser key to Maps JavaScript API and this app's website origins.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=DEMO_MAP_ID
# Optional browser-restricted key, with only Maps Embed API enabled.
# Street View links work without this. Set it before building for embedded panoramas.
VITE_GOOGLE_MAPS_EMBED_API_KEY=
